<style>
  .add-to-cart-button {
    width: fit-content;
    padding: 8px 16px;
    background-color: #000000;
    border-radius: 1000px;
    border: none;
    color: #ffffff;
    font-size: 16px;
    font-weight: 500;
    cursor: pointer;
    position: relative;
    overflow: hidden;
    &::before,
    &::after {
      height: 100%;
      position: absolute;
      top: 0;
      left: 0;
      transform: translateX(-100px) skewX(-15deg);
      content: "";
    }
    &::before {
      width: 60px;
      background: rgba(255, 255, 255, 0.5);
      filter: blur(30px);
      opacity: 0.5;
    }
    &::after {
      width: 30px;
      left: 30px;
      background: rgba(255, 255, 255, 0.2);
      filter: blur(5px);
    }
     &:hover {
      &::before {
        opacity: 1;
      }
      &::before,
      &::after {
        transform: translateX(300px) skewX(-15deg);
        transition: all 1s ease;
      }
    }
  }
</style>
<button
  class="add-to-cart-button"
  onclick="addToCart('{{ data.settings.product.variants.first.id }}')"
  {% if data.settings.product.available == false %}
  disabled
  style="cursor: not-allowed; opacity: 0.5;"
  {% endif %}>
  {% if data.settings.product.available %}
    Add to Cart
  {% else %}
    Sold Out
  {% endif %}
</button>