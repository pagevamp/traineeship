<style>
  .shopall__button {
    padding: 9px 16px;
    background-color: #000000;
    border-radius: 1000px;
    border: none;
    cursor: pointer;
    width: fit-content;
    white-space: nowrap;
    position: relative;
    overflow: hidden;
    &::before,
    &::after {
      height: 100%;
      position: absolute;
      top: 0;
      left: 0;
      transform: translateX(-100px) skewX(-15deg);
      content: "";
    }
    &::before {
      width: 60px;
      background: rgba(255, 255, 255, 0.5);
      filter: blur(30px);
      opacity: 0.5;
    }
    &::after {
      width: 30px;
      left: 30px;
      background: rgba(255, 255, 255, 0.2);
      filter: blur(5px);
    }
     &:hover {
      &::before {
        opacity: 1;
      }
      &::before,
      &::after {
        transform: translateX(300px) skewX(-15deg);
        transition: all 1s ease;
      }
    }
  }

  .shopall__button a {
    text-decoration: none;
    font-size: 16px;
    font-weight: 500;
    line-height: 14px;
    color: #ffffff;
  }
</style>

<div class="shopall__button">
  <a href="{{ url }}">{{ data }}</a>
</div>