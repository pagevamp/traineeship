{{ 'section-past-projects.css' | asset_url | stylesheet_tag }}
<div class="pastprojects" style="background-color:{{section.settings.background_color}}">
  <div class="pastprojects__container">
    <div class="pastprojects__title">
      {{ section.settings.title }}
    </div>

    <div class="pastprojects__description-container">
      <div class="pastprojects__description">
        {{ section.settings.description }}
      </div>

      <div class="pastprojects__button">
        <a href="{{ section.settings.button_url }}">{{ section.settings.button }}</a>
      </div>
    </div>
  </div>

  <div class="pastprojects__projects-container">
    {% for block in section.blocks %}
      {% assign collection = block.settings.product_collection %}
      {% if collection != blank %}
        <div class="marquee">
          <div class="marquee__content">
            {% assign products = collection.products %}
            {% assign product_count = products.size %}
            {% for i in (1..product_count) %}
              {% assign random_index = "now" | date: "%N" | modulo: product_count %}
              {% assign product = products[random_index] %}
              {% if product.featured_image != blank %}
                <div class="pastprojects__project">
                  {% if product.metafields.custom.country != blank %}
                    <div class="product__country">
                      <p>{% render 'icon-universe' %}</p>
                      <span>{{ product.metafields.custom.country | capitalize }}</span>
                    </div>
                  {% endif %}
                  <img
                    src="{{ product.featured_image | image_url: width:200, height:200 }}"
                    loading="eager"
                    width="120"
                    height="120"
                    alt="{{ product.featured_image.alt | escape }}">
                </div>
              {% endif %}
            {% endfor %}
          </div>
        </div>
      {% endif %}
    {% endfor %}
  </div>
</div>

{% schema %}
  {
    "name": "Past Projects",
    "settings": [
      {
        "id": "title",
        "label": "Title",
        "type": "text",
        "default": "Past Projects"
      },
      {
        "id": "description",
        "label": "Description",
        "type": "text",
        "default": "Shop all 402 products what we've built over the past 4 years with the Global Design Project"
      },
      {
        "id": "button",
        "label": "Button",
        "type": "text",
        "default": "Shop All Projects"
      },
      {
        "id": "button_url",
        "label": "Button URL",
        "type": "url"
      },
      {
        "type": "header",
        "content": "Styles",
        "info": "Select Styles"
      },
      {
        "id": "background_color",
        "label": "Background Color",
        "type": "select",
        "default": "#f1f1f1",
        "options": [
          {
            "value": "#f1f1f1",
            "label": "Default"
          },
          {
            "value": "#E9e5e2",
            "label": "Off White"
          },
          {
            "value": "#a8a8a8",
            "label": "Gray"
          }
        ]
      }

    ],
    "blocks": [
      {
        "name": "Product Collection",
        "type": "product_collection",
        "settings": [
          {
            "id": "product_collection",
            "label": "Product Collection",
            "type": "collection"
          }
        ],
        "limit": 5
      }
    ],
    "presets": [
      {
        "name": "Past Projects"
      }
    ]
  }
{% endschema %}