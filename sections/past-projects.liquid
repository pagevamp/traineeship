{{ 'section-past-projects.css' | asset_url | stylesheet_tag }}
<script src="{{ 'pastproject-play-pause.js' | asset_url }}" defer></script>
<div class="pastprojects" style="background-color:{{section.settings.background_color}}">
  <div class="pastprojects__container">
    <div class="pastprojects__title">
      {{ section.settings.title }}
    </div>

    <div class="pastprojects__description-container">
      <div class="pastprojects__description">
        {{ section.settings.description }}
      </div>

      {% render 'shop-all-projects-button' data: section.settings.button
        , url: section.settings.button_url %}
    </div>
  </div>

  <div class="pastprojects__animation-pause">
    <button class="pause-button active" aria-label="Pause Animation">
      {% render 'icon-pause' %}
      <span class="hidden-text" aria-label="Pause Animation">Pause</span>
    </button>
    <button class="play-button" aria-label="Play Animation">
      {% render 'icon-play' %}
      <span class="hidden-text" aria-label="Play Animation">Play</span>
    </button>
  </div>

  <div class="pastprojects__projects-container">
    {% for block in section.blocks %}
      {% assign collection = block.settings.product_collection %}
      {% if collection != blank %}
        <div class="marquee">
          <div class="marquee__content" style="--marquee-speed-mobile: {{ section.settings.marquee_speed_mobile }}s; --marquee-speed-desktop: {{ section.settings.marquee_speed_desktop }}s;">
            {% assign products = collection.products %}

            {% for product in products %}
              {% if product.featured_image != blank %}
                <div class="pastprojects__project">
                  {% if product.metafields.custom.country != blank %}
                    <div class="product__country">
                      <p>{% render 'icon-universe' %}</p>
                      <span>{{ product.metafields.custom.country | capitalize }}</span>
                    </div>
                  {% endif %}

                  <img
                    src="{{ product.featured_image | image_url: width:200, height:200 }}"
                    loading="eager"
                    width="120"
                    height="120"
                    alt="{{ product.featured_image.alt | escape }}">
                </div>
              {% endif %}
            {% endfor %}

            <!-- Duplicate content -->

            {% for product in products %}
              {% if product.featured_image != blank %}
                <div class="marquee__item">
                  {% if product.metafields.custom.country != blank %}
                    <div class="product__country">
                      <p>{% render 'icon-universe' %}</p>
                      <span>{{ product.metafields.custom.country | capitalize }}</span>
                    </div>
                  {% endif %}
                  <img
                    src="{{ product.featured_image | image_url: width:200, height:200 }}"
                    loading="eager"
                    width="120"
                    height="120"
                    alt="{{ product.featured_image.alt | escape }}">
                </div>
              {% endif %}
            {% endfor %}
          </div>
        </div>
      {% endif %}
    {% endfor %}
  </div>
</div>


{% schema %}
  {
    "name": "Past Projects",
    "settings": [
      {
        "id": "title",
        "label": "Title",
        "type": "text",
        "default": "Past Projects"
      },
      {
        "id": "description",
        "label": "Description",
        "type": "text",
        "default": "Shop all 402 products what we've built over the past 4 years with the Global Design Project"
      },
      {
        "id": "button",
        "label": "Button",
        "type": "text",
        "default": "Shop All Projects"
      },
      {
        "id": "button_url",
        "label": "Button URL",
        "type": "url"
      },
      {
        "type": "header",
        "content": "Styles",
        "info": "Select Styles"
      },
      {
        "id": "background_color",
        "label": "Background Color",
        "type": "select",
        "default": "#f1f1f1",
        "options": [
          {
            "value": "#f1f1f1",
            "label": "Default"
          },
          {
            "value": "#E9e5e2",
            "label": "Off White"
          },
          {
            "value": "#a8a8a8",
            "label": "Gray"
          }
        ]
      },
      {
        "type": "header",
        "content": "Marquee Settings"
      },
      {
        "id": "marquee_speed_mobile",
        "label": "Marquee Speed (Mobile)",
        "type": "range",
        "default": 20,
        "step": 5,
        "min": 5,
        "max": 100
      },
      {
        "id": "marquee_speed_desktop",
        "label": "Marquee Speed (Desktop)",
        "type": "range",
        "default": 40,
        "step": 5,
        "min": 5,
        "max": 100
      }

    ],
    "blocks": [
      {
        "name": "Product Collection",
        "type": "product_collection",
        "settings": [
          {
            "id": "product_collection",
            "label": "Product Collection",
            "type": "collection"
          }
        ],
        "limit": 5
      }
    ],
    "presets": [
      {
        "name": "Past Projects"
      }
    ]
  }
{% endschema %}