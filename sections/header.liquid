{{ 'header.css' | asset_url | stylesheet_tag }}
<script src="{{ 'header-functionality.js' | asset_url }}" defer="defer"></script>
<header class="header" id="Header">
  <h2 class="header__title">Header</h2>
  <nav class="header__nav">
    <div class="header__nav-hamburger">
      <a href="#" class="drawer-trigger">{% render 'icon-hamburger' %}</a>
    </div>

    <div class="drawer">
      <div class="drawer__header">
        <button class="drawer__close">{% render 'icon-close' %}</button>
      </div>

      <div class="drawer__content">
        <div class="drawer__menu">
          {% if linklists[section.settings.main_menu].links.size > 0 %}
            {% for link in linklists[section.settings.main_menu].links %}
              <a href="{{ link.url }}" class="drawer__menu-link {% if link.url == request.path %}active{% endif %}">
                <span class="drawer__menu-text">{{ link.title }}</span>
                <span class="drawer__menu-dot"></span>
              </a>
            {% endfor %}
          {% endif %}
        </div>
      </div>
    </div>

    <div class="header__nav-menu-container">
      {% if settings.primary_logo != blank %}
        <div class="header__nav-logo">
          <a href="{{settings.logo_url}}">
            <img
              src="{{ settings.primary_logo | image_url: height: 120, width: 90 }}"
              alt="Logo"
              height=""
              width="" />
          </a>
        </div>
      {% endif %}

      <div class="header__nav-menu">
        {% if linklists[section.settings.main_menu].links.size > 0 %}
          {% for link in linklists[section.settings.main_menu].links %}
            <a href="{{ link.url }}" class="header__nav-menu-link {% if forloop.first %}active{% endif %} animated-hover">
              <span class="header__nav-menu-text">{{ link.title }}</span>
              <span class="header__nav-menu-dot"></span>
            </a>
          {% endfor %}
        {% endif %}
      </div>
    </div>

    <div class="header__nav-icons">
      {% if linklists[section.settings.secondary_menu].links.size > 0 %}
        {% for link in linklists[section.settings.secondary_menu].links %}
          <ul class="header__nav-loyalty">

            <li class="header__nav-loyalty animated-hover">
              <a href="{{ link.url }}">{{ link.title }}</a>
            </li>

          </ul>
        {% endfor %}
      {% endif %}
      <ul class="header__nav-icons-list">

        <li class="header__nav-icon-search animated-hover">
          <a href="#">{% render 'icon-search' %}</a>
        </li>

        <li class="header__nav-icon-cart">
          <a href="/cart">{% render 'icon-cart' %}</a>
          <span class="header__nav-icon-cart-item-count" data-cart-count>{{ cart.item_count }}</span>
        </li>

        <li class="header__nav-icon-user animated-hover">
          <a href="#">{% render 'icon-user' %}</a>
        </li>

        <li class="header__nav-icon-cart-item animated-hover">
          <a href="/cart">{% render 'icon-cart' %}</a>
          <span class="header__nav-icon-cart-item-count" data-cart-count>{{ cart.item_count }}</span>
        </li>

      </ul>
    </div>


  </nav>
</header>

{% schema %}
  {
    "name": "Header",
    "settings": [
      {
        "type": "header",
        "content": "Main Menu",
        "info": "This menu will be displayed on the left side of the header"
      },
      {
        "type": "link_list",
        "id": "main_menu",
        "default": "main-menu",
        "label": "Main Menu"
      },
      {
        "type": "header",
        "content": "Secondary Menu",
        "info": "This menu will be displayed on the right side of the header"
      },
      {
        "type": "link_list",
        "id": "secondary_menu",
        "label": "Secondary Menu",
        "default": "main-menu"
      }
    ]
  }
{% endschema %}