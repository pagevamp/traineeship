{{ 'section-richtext.css' | asset_url | stylesheet_tag }}

<div class="richtext">
  {% for block in section.blocks %}
    <div class="richtext__container">
      {% if block.settings.brand_image.src %}
        <picture>
          <source srcset="{{ block.settings.brand_image.src | image_url: width:1100, height:1100 }}" media="(min-width: 1440px)">

          <source srcset="{{ block.settings.brand_image.src | image_url: width:800, height:800 }}" media="(min-width: 1024px)">

          <source srcset="{{ block.settings.brand_image.src | image_url: width:600, height:600 }}" media="(min-width: 768px)">

          <source srcset="{{ block.settings.brand_image.src | image_url: width:500, height:500 }}" media="(min-width: 425px)">

          <source srcset="{{ block.settings.brand_image.src | image_url: width:358, height:358 }}" media="(min-width: 375px)">

          <img
            class="richtext__image"
            src="{{ block.settings.brand_image.src | image_url: width:358, height:358 }}"
            alt="Brand Image"
            height="358"
            width="358">
        </picture>

      {% else %}
        <div class="richtext__image-substitute"></div>
      {% endif %}

      <div class="richtext__description" style="position: absolute; {{ block.settings.description_position }}; {% if block.settings.description_position contains 'right' %}margin-left: auto; text-align: right; width: fit-content;{% endif %}">
        {% if block.settings.country != blank %}
          <div class="richtext__description-country">

            <div class="richtext__description-country-icon">
              {% render 'icon-universe' %}
            </div>

            {% if block.settings.country %}
              <span class="richtext__description-country-text">{{ block.settings.country }}</span>
            {% endif %}
          </div>
        {% endif %}

        {% if block.settings.name != blank %}
          <div class="richtext__description-name">{{ block.settings.name }}</div>
        {% endif %}

        {% if block.settings.first_button or block.settings.second_button %}
          <div class="richtext__description-btn-container" style="justify-content: {{ block.settings.button_position }}">

            {% if block.settings.primary_button == 'first' and block.settings.first_button != blank %}
              <a
                class="richtext__description-btn primary"
                href="{{ block.settings.first_button_link }}"
                style="background-color: {{ block.settings.primary_button_bg }}; color: {{ block.settings.primary_button_text_color }};">
                {{ block.settings.first_button }}
              </a>
            {% elsif block.settings.primary_button == 'second' and block.settings.second_button != blank %}
              <a
                class="richtext__description-btn primary"
                href="{{ block.settings.second_button_link }}"
                style="background-color: {{ block.settings.primary_button_bg }}; color: {{ block.settings.primary_button_text_color }};">
                {{ block.settings.second_button }}
              </a>
            {% endif %}


            {% if block.settings.primary_button == 'second' and block.settings.first_button != blank %}
              <a
                class="richtext__description-btn secondary"
                href="{{ block.settings.first_button_link }}"
                style="background-color: {{ block.settings.secondary_button_bg }}; color: {{ block.settings.secondary_button_text_color }};">
                {{ block.settings.first_button }}
              </a>
            {% elsif block.settings.primary_button == 'first' and block.settings.second_button != blank %}
              <a
                class="richtext__description-btn secondary"
                href="{{ block.settings.second_button_link }}"
                style="background-color: {{ block.settings.secondary_button_bg }}; color: {{ block.settings.secondary_button_text_color }};">
                {{ block.settings.second_button }}
              </a>
            {% endif %}
          </div>
        {% endif %}
      </div>

      <div class="richtext__signature">
        <picture>
          {% if block.settings.signature %}
            <source srcset="{{ block.settings.signature.src |  image_url: width: 355, height: 138 }}" media="(min-width: 1024px)">

            <img
              class="richtext__signature-image"
              src="{{ block.settings.signature.src | image_url: width: 133, height: 52 }}"
              alt="Signature"
              height="52"
              width="133">
          {% endif %}
        </picture>
      </div>
    </div>
  {% endfor %}
</div>


{% schema %}
  {
    "name": "Brand",
    "settings": [],
    "blocks": [
      {
        "name": "Brand",
        "type": "Brand",
        "settings": [
          {
            "id": "brand_image",
            "label": "Pick Image",
            "type": "image_picker"
          },
          {
            "id": "description_position",
            "label": "Select the position of the description",
            "type": "select",
            "default": "bottom:16px;left:16px",
            "options": [
              {
                "value": "top:16px;left:16px",
                "label": "Top Left"
              },
              {
                "value": "top:50%;left:16px;width:fit-content;",
                "label": "Center Left"
              },
              {
                "value": "bottom:16px;left:16px",
                "label": "Bottom Left"
              },

              {
                "value": "top:16px;right:16px;width:fit-content;",
                "label": "Top Right"
              },
              {
                "value": "top:50%;right:16px;width:fit-content;",
                "label": "Center Right"
              },
              {
                "value": "bottom:16px;right:16px;width:fit-content;",
                "label": "Bottom Right"
              }

            ]
          },
          {
            "id": "country",
            "label": "Country",
            "type": "text",
            "default": "Nepal"
          },

          {
            "id": "signature",
            "label": "Signature",
            "type": "image_picker"
          },
          {
            "id": "name",
            "label": "Name",
            "type": "text",
            "default": "EMEA Ft CJ Wallace"
          },
          {
            "type": "header",
            "content": "Buttons"
          },
          {
            "id": "primary_button",
            "label": "Select Primary Button",
            "type": "select",
            "options": [
              {
                "value": "first",
                "label": "First Button"
              },
              {
                "value": "second",
                "label": "Second Button"
              }
            ],
            "default": "first"
          },
          {
            "id": "first_button",
            "label": "First Button Text",
            "type": "text",
            "default": "Shop Now"
          },
          {
            "id": "first_button_link",
            "label": "First Button Link",
            "type": "url"
          },
          {
            "id": "second_button",
            "label": "Second Button Text",
            "type": "text",
            "default": "Learn More"
          },
          {
            "id": "second_button_link",
            "label": "Second Button Link",
            "type": "url"
          },
          {
            "type": "header",
            "content": "Button Styles"
          },
          {
            "id": "button_position",
            "label": "Button Position",
            "type": "select",
            "options": [
              {
                "value": "flex-start",
                "label": "Left"
              },
              {
                "value": "center",
                "label": "Center"
              },
              {
                "value": "flex-end",
                "label": "Right"
              }
            ],
            "default": "flex-start"
          },
          {
            "id": "primary_button_bg",
            "label": "Primary Button Background",
            "type": "color",
            "default": "#000000"
          },
          {
            "id": "primary_button_text_color",
            "label": "Primary Button Text Color",
            "type": "color",
            "default": "#FFFFFF"
          },
          {
            "id": "secondary_button_bg",
            "label": "Secondary Button Background",
            "type": "color",
            "default": "#FFFFFF"
          },
          {
            "id": "secondary_button_text_color",
            "label": "Secondary Button Text Color",
            "type": "color",
            "default": "#000000"
          }
        ],
        "limit": 1
      }
    ],
    "presets": [
      {
        "name": "Brand"
      }

    ]
  }
{% endschema %}