{{ 'detail-page-product.css' | asset_url | stylesheet_tag }}
<div class="detail-page-product">
  <div class="detail-page-product__container">
    {% for block in section.blocks %}
      <div class="detail-page-card">
        <div class="detail-page-card__image">
          <picture>
            <source srcset="{{ block.settings.image | image_url: width: 437  , height: 437 }}" media="(min-width: 768px)">
            <source srcset="{{ block.settings.image | image_url: width: 332  , height: 332 }}">
            <img
              src="{{ block.settings.image | image_url: width: 332  , height: 332 }}"
              alt="Product Image"
              width="332"
              height="332">
          </picture>
        </div>
        <div class="detail-page-card__content">
          <div class="detail-page-card__content-title">
            <h3>{{ block.settings.title }}</h3>
            <p>${{ block.settings.price }}</p>
          </div>
          <div class="detail-page-card__content-description">
            <p>{{ block.settings.description }}</p>
          </div>
        </div>
        <a class="detail-page-card__view-button" href="{{ block.settings.url }}">View</a>
      </div>
    {% endfor %}
  </div>
</div>
{% schema %}
  {
    "name": "Detail Page Products",
    "max_blocks": 12,
    "settings": [],
    "blocks": [
      {
        "name": "Product Card",
        "type": "detail_page_product",
        "settings": [
          {
            "type": "image_picker",
            "id": "image",
            "label": "Product Image",
            "info": "437 x 437px recommended"
          },
          {
            "type": "text",
            "id": "title",
            "label": "Product Title",
            "default": "Product Name"
          },
          {
            "type": "text",
            "id": "price",
            "label": "Product Price",
            "default": "99.99"
          },
          {
            "type": "textarea",
            "id": "description",
            "label": "Product Description",
            "default": "Enter product description here"
          },
          {
            "type": "url",
            "id": "url",
            "label": "Product URL",
            "info": "Link to the product detail page"
          }
        ]
      }
    ],
    "presets": [
      {
        "name": "Detail Page Products",
        "blocks": [
          {
            "type": "detail_page_product"
          }
        ]
      }
    ]
  }
{% endschema %}